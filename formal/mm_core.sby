# SymbiYosys: bus-protocol and FSM properties of mm_core (N = 2, K_MAX = 4).
#   make -C formal     prove: k-induction (unbounded proof); cover: reachability
# (bus inputs are unconstrained, so the proof covers ANY bus master)
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 24
cover: mode cover
cover: depth 40

[engines]
smtbmc z3

[script]
read_verilog -sv mm_core.v
read_verilog -formal mm_core_props.v
prep -top mm_core_props

[files]
build/mm_core.v
mm_core_props.v
